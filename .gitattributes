# Normaliza los fines de línea en el repositorio (LF) y deja que Git
# los adapte al sistema al hacer checkout.
* text=auto

# Scripts que se ejecutan en Linux/macOS o dentro de contenedores: siempre LF
/mvnw text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf

# Scripts de Windows: siempre CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binarios
*.jar binary
*.png binary
*.jpg binary
*.ico binary
